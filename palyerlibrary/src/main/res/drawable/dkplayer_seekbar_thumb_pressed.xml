<?xml version="1.0" encoding="utf-8"?>
<!-- 按压状态滑块：橙色主体 + 更大的橙色光晕环 + 白描边。
     旧实现用 #30FFFFFF 白圈 + #40000000 黑阴影，压在橙色进度条上呈现
     「白点 + 黑晕」，与品牌色完全脱节（真机像素采样确认：主体 255,255,255；
     光晕 68,59,53）。按下时光晕比 normal 更大更实，作为按压反馈。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 橙色光晕环（按下比 normal 大 2dp、更实） -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/op_brand_disabled"/>
            <size android:width="20dp" android:height="20dp"/>
        </shape>
    </item>
    <!-- 主体橙点（白描边，按下时比 normal 大 2dp） -->
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/op_brand"/>
            <stroke android:width="1dp" android:color="#FFFFFFFF"/>
            <size android:width="14dp" android:height="14dp"/>
        </shape>
    </item>
</layer-list>
