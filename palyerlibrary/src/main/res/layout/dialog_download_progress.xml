<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/dialog_bg"
    android:minWidth="200dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="正在下载翻译模型"
        android:textColor="@color/op_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <!-- 圆形进度条容器 -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp">

        <!-- 背景圆环。用具体 style 而非 ?android:attr/progressBarStyleHorizontal：
             后者取宿主主题的值，宿主换主题会改变本面板外观——与本系列面板
             「不依赖任何主题属性」的约定冲突（progressDrawable 已完全自绘，
             style 只影响次要默认属性，换具体 style 无副作用）。 -->
        <ProgressBar
            android:id="@+id/progress_bg"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/progress_circle_bg" />

        <!-- 前景进度圆环 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_circle_fg" />

        <!-- 百分比文字 -->
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0%"
            android:textColor="@color/op_success"
            android:textSize="16sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- 提示文字：失败时这里放的是原始错误串，可能很长，限高避免撑爆弹窗 -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:ellipsize="end"
        android:gravity="center"
        android:text="首次使用需要下载"
        android:textColor="@color/op_text_secondary"
        android:textSize="12sp" />

</LinearLayout>
