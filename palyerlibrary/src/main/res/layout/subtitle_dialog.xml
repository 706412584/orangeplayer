<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_scrim">

    <ScrollView
        android:layout_width="@dimen/op_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/setup_panel_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字幕设置"
                android:textColor="@color/op_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- 字幕开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="显示字幕"
                    android:textColor="@color/op_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/subtitle_switch"
                    style="@style/SubtitlePanelSwitch" />
            </LinearLayout>

            <!-- 字幕状态 -->
            <TextView
                android:id="@+id/subtitle_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未加载字幕"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginBottom="16dp" />

            <!-- 加载字幕按钮 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="加载字幕"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btn_load_local"
                style="@style/SubtitlePanelButton"
                android:layout_width="match_parent"
                android:text="从本地加载" />

            <TextView
                android:id="@+id/btn_load_url"
                style="@style/SubtitlePanelButton"
                android:layout_width="match_parent"
                android:text="从网络加载" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- OCR 翻译字幕 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OCR 翻译字幕"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/ocr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="识别视频画面中的硬字幕并翻译"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btn_ocr_translate"
                style="@style/SubtitlePanelButton"
                android:layout_width="match_parent"
                android:text="开启 OCR 翻译" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- AI 批量翻译字幕 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 批量翻译"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/ai_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 翻译已加载的字幕（分批请求 LLM，一次译完）"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                android:id="@+id/btn_ai_translate"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="开始翻译" />

                <TextView
                android:id="@+id/btn_ai_settings"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="AI 设置" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- AI 语音生成字幕（离线 ASR：抽音轨→识别→字幕） -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI 语音生成字幕"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/asr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="识别视频音轨自动生成字幕（支持中/英/日/韩）"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- 边看边识别开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="边看边识别（关：完整下载后一次识别）"
                    android:textColor="@color/op_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/asr_live_switch"
                    style="@style/SubtitlePanelSwitch" />
            </LinearLayout>

            <!-- 自动生成字幕开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="新视频自动开始（关：手动点下方按钮）"
                    android:textColor="@color/op_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/asr_auto_switch"
                    style="@style/SubtitlePanelSwitch" />
            </LinearLayout>

            <!-- 识别后自动翻译开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="识别后自动翻译（用 AI 设置中的目标语言）"
                    android:textColor="@color/op_text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/asr_translate_switch"
                    style="@style/SubtitlePanelSwitch" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_asr_generate"
                style="@style/SubtitlePanelButton"
                android:layout_width="match_parent"
                android:text="生成本视频字幕" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- 字幕大小 -->
            <TextView
                android:id="@+id/subtitle_size_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="字幕大小: 24sp"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/subtitle_size_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="50"
                android:progressDrawable="@drawable/seekbar_progress"
                android:thumb="@drawable/dkplayer_seekbar_thumb" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/op_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- 字幕延迟 -->
            <TextView
                android:id="@+id/subtitle_delay_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="字幕延迟: 0.0s"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                android:id="@+id/btn_subtitle_delay_minus"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="- 0.5s" />

                <TextView
                android:id="@+id/btn_subtitle_delay_reset"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="重置" />

                <TextView
                android:id="@+id/btn_subtitle_delay_plus"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="+ 0.5s" />
            </LinearLayout>

            <!-- 音频延迟（mpv 内核音画同步补偿，正值延后音频） -->
            <TextView
                android:id="@+id/audio_delay_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音频延迟: 0.0s"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音画不同步时补偿音频轨道（仅 mpv 内核）"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                android:id="@+id/btn_audio_delay_minus"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="- 0.1s" />

                <TextView
                android:id="@+id/btn_audio_delay_reset"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="重置" />

                <TextView
                android:id="@+id/btn_audio_delay_plus"
                style="@style/SubtitlePanelButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="+ 0.1s" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
