<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_scrim">

    <ScrollView
        android:layout_width="@dimen/op_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/setup_panel_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 翻译设置"
            android:textColor="@color/op_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接入 OpenAI 兼容接口（DeepSeek / Qwen / 智谱 / agnes 等均可）。批量翻译字幕时使用，每批一次请求，术语全片一致。"
            android:textColor="@color/op_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- 翻译引擎：远程 LLM / 本地 MLKit 二选一。
             配了 Key 又想离线（或想省 token）时，「仅本地」必须能压过 Key。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="翻译引擎"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_ai_engine"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_ai_engine_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/op_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <!-- 注意：不用 inputType="textPassword"、也不在代码里设
             PasswordTransformationMethod——两者都会让系统把字段判定为「密码类型」，
             OPPO 等机型据此强制切到系统安全键盘，第三方输入法与粘贴全部不可用。
             这里保持普通文本类型，明文显示。 -->
        <EditText
            android:id="@+id/et_ai_api_key"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/edit_text_bg"
            android:hint="sk-..."
            android:textColor="@color/op_text_primary"
            android:textColorHint="@color/op_text_tertiary"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no"
            android:imeOptions="actionNext"
            android:layout_marginBottom="12dp" />

        <!-- API 地址 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API 地址（OpenAI 兼容 /v1）"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_ai_base_url"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/edit_text_bg"
            android:hint="https://apihub.agnes-ai.com/v1"
            android:textColor="@color/op_text_primary"
            android:textColorHint="@color/op_text_tertiary"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionNext"
            android:layout_marginBottom="12dp" />

        <!-- 模型 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/et_ai_model"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/edit_text_bg"
                android:hint="agnes-2.5-flash"
                android:textColor="@color/op_text_primary"
                android:textColorHint="@color/op_text_tertiary"
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:imeOptions="actionNext" />

            <Button
                android:id="@+id/btn_ai_fetch_models"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="14dp"
                android:text="获取模型"
                android:textColor="@color/op_text_primary"
                android:textSize="13sp"
                android:background="@drawable/btn_subtitle_bg" />
        </LinearLayout>

        <!-- 目标语言 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标语言"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_ai_target_lang"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:layout_marginBottom="12dp" />

        <!-- 本地翻译模型（MLKit，OCR 与语音识别共用同一份） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="源语言（仅预装本地模型用，识别时自动检测）"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinner_ai_source_lang"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/spinner_bg"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_ai_preinstall_model"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="预装本地翻译模型"
            android:textColor="@color/op_text_primary"
            android:textSize="13sp"
            android:background="@drawable/btn_subtitle_bg"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_ai_preinstall_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/op_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- 按钮区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_ai_settings_cancel"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:text="取消"
                android:textColor="@color/op_text_secondary"
                android:textSize="14sp"
                android:background="@android:color/transparent" />

            <Button
                android:id="@+id/btn_ai_settings_save"
                android:layout_width="80dp"
                android:layout_height="36dp"
                android:text="保存"
                android:textColor="@color/op_text_primary"
                android:textSize="14sp"
                android:background="@drawable/btn_subtitle_bg"
                android:layout_marginStart="8dp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
