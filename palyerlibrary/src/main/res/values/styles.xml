<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AVLoadingIndicatorView 样式 -->
    <style name="AVLoadingIndicatorView">
        <item name="minWidth">48dip</item>
        <item name="maxWidth">48dip</item>
        <item name="minHeight">48dip</item>
        <item name="maxHeight">48dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>

    <style name="AVLoadingIndicatorView.Large">
        <item name="minWidth">76dip</item>
        <item name="maxWidth">76dip</item>
        <item name="minHeight">76dip</item>
        <item name="maxHeight">76dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>

    <style name="AVLoadingIndicatorView.Small">
        <item name="minWidth">24dip</item>
        <item name="maxWidth">24dip</item>
        <item name="minHeight">24dip</item>
        <item name="maxHeight">24dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>
    
    <!-- Orange Player 样式 -->
    <style name="OrangeLoadingIndicatorView">
        <item name="minWidth">48dip</item>
        <item name="maxWidth">48dip</item>
        <item name="minHeight">48dip</item>
        <item name="maxHeight">48dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>

    <style name="OrangeLoadingIndicatorView.Large">
        <item name="minWidth">76dip</item>
        <item name="maxWidth">76dip</item>
        <item name="minHeight">76dip</item>
        <item name="maxHeight">76dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>

    <style name="OrangeLoadingIndicatorView.Small">
        <item name="minWidth">24dip</item>
        <item name="maxWidth">24dip</item>
        <item name="minHeight">24dip</item>
        <item name="maxHeight">24dip</item>
        <item name="indicatorName">BallPulseIndicator</item>
    </style>
    
    <!-- 透明 Dialog 主题 (兼容 Android 4.4) -->
    <style name="TransparentDialog" parent="android:Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    
    <!-- Orange Dialog 主题 -->
    <style name="OrangeDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <!-- ===== 扩展包管理面板：紧凑单行组件行 ===== -->
    <!-- 每行 56dp：左侧「名称 + 状态」两行文字，右侧一个小按钮。
         8 行共约 450dp，一屏可览，替代原先每项约 190dp 的纵向长列表。 -->
    <style name="BundleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="BundleRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BundleRowName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/op_text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 状态行允许两行：一行时「未安装 · 12.3MB · 系统要求 8.0」这类
         组合状态会被省略号吃掉最关键的「系统要求」部分（窄屏更明显） -->
    <style name="BundleRowStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/op_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 行内小按钮：固定最小宽度，避免「下载」与「删除」宽度差异过大。
         用 TextView 而非 Button：宿主是 Material3 主题，Button 会被替换成
         MaterialButton，自带 6dp 上下 inset 与较大的垂直 padding，压到 32dp
         会把 12sp 文字裁掉上半（真机实测）。TextView + gravity=center 无此问题，
         与 setup_dialog 里播放核心按钮（alihx 等）的写法一致。 -->
    <style name="BundleRowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/op_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <!-- clickable/focusable 交给 setOnClickListener 置位：显式 true 会让
             bindBundleRow 里 setOnClickListener(null)（不可用分支）之后仍可点 -->
        <item name="android:background">@drawable/btn_bundle_action_bg</item>
    </style>

    <style name="BundleRowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/op_divider</item>
    </style>

    <!-- ===== 字幕设置面板 =====
         与 BundleRowButton 同因：宿主是 Material3 主题，原生 <Button> 会被替换成
         MaterialButton（自带 6dp inset 与较大 padding），<Switch> 的 thumb/track
         会取主题的 colorSecondary/colorPrimary（Material3 默认紫/青），
         与橘子配色冲突。故按钮一律用 TextView + 显式 drawable，
         开关一律用 TextView + 自绘 pill 背景，不依赖任何主题属性。 -->

    <!-- 面板内的整行按钮（40dp 高，文字居中）。
         不写 clickable/focusable：TextView 的 setOnClickListener() 会自动置位，
         而显式写 true 会让 setOnClickListener(null) 之后**仍然可点**——
         那时有按压反馈却无任何响应，用户以为坏了。 -->
    <style name="SubtitlePanelButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textColor">@color/op_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/btn_subtitle_bg</item>
    </style>

    <!-- 开关：沿用 setup_dialog 的既有模式——TextView + 文案切换（「开启」/「关闭」），
         而不是原生 Switch。原生 Switch 的 thumb/track 取主题的 colorSecondary，
         Material3 默认是紫色，与橘子配色冲突；改 tint 又要在 Java 侧维护两套状态。
         用按钮承载布尔值语义与去广告开关完全一致，且无主题依赖。 -->
    <style name="SubtitlePanelSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/op_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <!-- clickable/focusable 同 SubtitlePanelButton：交给 setOnClickListener 置位 -->
        <!-- 初始文案：Java 侧 renderSwitchButton() 会按真实状态覆写。
             必须给默认值，否则布局预览与「Java 未跑到」时是一个无字橙块。 -->
        <item name="android:text">已关闭</item>
        <item name="android:background">@drawable/btn_bundle_delete_bg</item>
    </style>
</resources>
