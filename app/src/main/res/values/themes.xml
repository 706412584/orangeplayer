<resources xmlns:tools="http://schemas.android.com/tools">
	<!-- Base application theme. -->
	<style name="Base.Theme.橘子播放器" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Customize your light theme here. -->
		<!-- 主题色改为橙色 -->
		<item name="colorPrimary">@color/op_brand</item>
		<item name="colorPrimaryContainer">@color/op_brand</item>
		<item name="colorOnPrimaryContainer">@color/op_text_primary</item>
		<item name="colorSecondary">@color/op_brand</item>
		<item name="colorAccent">@color/op_brand</item>
		<!-- 按钮颜色 -->
		<item name="materialButtonStyle">@style/OrangeButton</item>
		<!-- 状态栏设置 -->
		<item name="android:statusBarColor">@android:color/black</item>
		<item name="android:windowLightStatusBar">false</item>
	</style>

	<!-- 橙色按钮样式 -->
	<style name="OrangeButton" parent="Widget.Material3.Button">
		<item name="backgroundTint">@color/op_surface_3</item>
		<item name="android:textColor">@color/op_text_primary</item>
	</style>

	<!-- 主操作：品牌橙实心 -->
	<style name="OrangeButtonPrimary" parent="OrangeButton">
		<item name="backgroundTint">@color/op_brand</item>
	</style>

	<!-- 次要操作：描边 -->
	<style name="OrangeButtonSecondary" parent="Widget.Material3.Button.OutlinedButton">
		<item name="android:textColor">@color/op_text_primary</item>
		<item name="strokeColor">@color/op_divider</item>
	</style>

	<!-- 分组小标题 -->
	<style name="OrangeSectionTitle">
		<item name="android:textColor">@color/op_text_secondary</item>
		<item name="android:textSize">12sp</item>
		<item name="android:textStyle">bold</item>
		<item name="android:layout_marginTop">12dp</item>
		<item name="android:layout_marginBottom">6dp</item>
	</style>
	
	<style name="Theme.橘子播放器" parent="Base.Theme.橘子播放器"/>
</resources>